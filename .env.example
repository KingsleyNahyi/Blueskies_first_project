# Copy to .env and fill in for local dev. The server reads these via
# plain os.Getenv, so export them however you like (direnv, docker-compose,
# your shell profile, etc) — there's no .env loader wired in yet.

PORT=8080
APP_ENV=dev

# Local dev: a plain sqlite file, no auth token needed.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Production (Turso): something like
# DATABASE_URL=libsql://bluesbirds-academy-<org>.turso.io
# DATABASE_AUTH_TOKEN=<token from `turso db tokens create`>

JWT_SECRET=change-me-to-something-long-and-random
